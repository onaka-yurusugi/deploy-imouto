# ローカル開発用。デプロイナウでは .env は読まれないので、ダッシュボードか `lolipop env create` で設定する。
OPENAI_API_KEY=
# fine-grained PAT（Contents: Read and write、対象リポジトリのみ）
GITHUB_TOKEN=
GITHUB_REPO=onaka-yurusugi/deploy-imouto
MAILBOX_BRANCH=mailbox
# 任意: 通話とお手紙の上限
CALL_DAILY_LIMIT=200
CALL_PER_IP_DAILY_LIMIT=20
LETTER_HOURLY_LIMIT=5
